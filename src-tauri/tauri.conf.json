{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "STRYV",
 "version": "0.1.0",
 "identifier": "app.stryv.desktop",
 "build": {
  "frontendDist": "../src"
 },
 "app": {
  "withGlobalTauri": true,
  "security": {
   "csp": null
  },
  "windows": [
   {
    "title": "STRYV",
    "width": 1180,
    "height": 760,
    "minWidth": 960,
    "minHeight": 600,
    "backgroundColor": "#090B12",
    "visible": false
   }
  ]
 },
 "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
   "icons/icon.png",
   "icons/icon.ico"
  ]
 }
}